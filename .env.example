# Bara: salin ke .env lalu isi.
# Kunci API: dipakai untuk setup admin pertama dan akses skrip (X-API-Key).
# Buat acak & panjang, mis: openssl rand -hex 24
API_KEY=
# Alamat bind di host. 127.0.0.1 = hanya bisa diakses dari VPS itu sendiri.
# Ubah ke 0.0.0.0 hanya jika memakai reverse proxy/VPN dan paham risikonya.
BIND_ADDRESS=127.0.0.1
# Port di host
PORT=8000
# Timezone default untuk jadwal
TZ=Asia/Jakarta
# Percayai header X-Forwarded-For/Proto dari reverse proxy (mis. Caddy di VPS).
# 0 = abaikan header tersebut (default). 1 = pakai IP asli pengunjung untuk
# pembatasan login dan tandai cookie sebagai Secure di HTTPS.
# AKTIFKAN HANYA jika BIND_ADDRESS=127.0.0.1 dan semua akses lewat reverse proxy;
# bila port terbuka langsung, pengunjung bisa memalsukan IP dan menghindari pembatasan login.
TRUST_PROXY=0
# Alamat proxy yang dipercaya saat TRUST_PROXY=1. "*" aman jika port hanya di 127.0.0.1.
FORWARDED_ALLOW_IPS=*

# Kunci enkripsi untuk cookie dan rahasia notifikasi di database (AES-256-GCM).
# Kosong = dibuat otomatis di /data/secret.key. SIMPAN CADANGANNYA: tanpa kunci ini cookie tidak bisa dibaca.
# Buat dengan: openssl rand -hex 32
SECRET_KEY=
# Retensi riwayat per akun: hapus yang lebih tua dari N hari, dan simpan maksimal N run per akun.
HISTORY_DAYS=90
HISTORY_PER_ACCOUNT=1000
# Batas jumlah akun TikTok: total panel, per pengguna biasa, dan per admin.
MAX_ACCOUNTS=100
MAX_ACCOUNTS_PER_USER=5
MAX_ACCOUNTS_PER_ADMIN=10

# --- Antrean browser ---
# Jumlah worker Chromium untuk job kirim/cek cookie (1-4). RAM 2 GB: 1, 4 GB: 2, 8 GB: 3-4.
BROWSER_WORKERS=1
# Jumlah sesi login remote bersamaan di seluruh panel (1-3). Menghabiskan RAM seperti worker.
LOGIN_SESSIONS=1
# Jeda acak (detik) antar job agar kiriman tidak beruntun dari satu IP.
QUEUE_JITTER_MIN=5
QUEUE_JITTER_MAX=20
# Mulai ulang proses Chromium setiap N job, atau bila memorinya (PSS, MB) melewati batas.
BROWSER_RECYCLE_JOBS=25
BROWSER_MAX_MB=700
# auto = pakai chrome-headless-shell (lebih ringan) bila terpasang, jika tidak Chromium penuh; full | shell untuk memaksa.
BROWSER_KIND=auto

# Halaman depan (landing page) untuk pengunjung yang belum login. 0 = langsung tampilkan halaman login di "/"
LANDING_ENABLED=1
# Tautan tombol "Panduan Pasang" di landing page (opsional, harus diawali http:// atau https://). Kosong = tombol disembunyikan
LANDING_DOCS_URL=

# Image jadi dari GHCR (opsional). Kosongkan untuk build lokal. Contoh: ghcr.io/<pemilik>/<repo>:latest
BARA_IMAGE=

# Dead-man's switch (opsional): URL push dari healthchecks.io atau Uptime Kuma. Bara memanggilnya tiap 5 menit selama /api/health?deep=1 OK.
# Bila Bara mati atau scheduler macet, ping berhenti dan layanan itu mengirim peringatan.
HEALTHCHECK_PING_URL=
