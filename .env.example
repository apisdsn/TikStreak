# Salin ke .env lalu isi.
# Access key untuk login ke UI (buat acak & panjang, mis: openssl rand -hex 24)
API_KEY=
# Alamat bind di host. 127.0.0.1 = hanya bisa diakses dari VPS itu sendiri.
# Ubah ke 0.0.0.0 hanya jika memakai reverse proxy/VPN dan paham risikonya.
BIND_ADDRESS=127.0.0.1
# Port di host
PORT=8000
# Timezone default untuk jadwal
TZ=Asia/Jakarta
