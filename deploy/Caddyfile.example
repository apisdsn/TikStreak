# Bara: contoh Caddyfile. Ganti panel.example.com dengan domain Anda.
# Port di reverse_proxy harus sama dengan PORT di file .env.
panel.example.com {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	reverse_proxy 127.0.0.1:8001
}

# Varian bila Caddy berjalan sebagai container pada jaringan Docker yang sama dengan service "bara":
#   reverse_proxy bara:8000
